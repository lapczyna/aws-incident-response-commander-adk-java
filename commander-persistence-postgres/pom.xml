<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lapczynski.commander</groupId>
    <artifactId>aws-incident-response-commander</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>commander-persistence-postgres</artifactId>
  <name>Commander :: Persistence (PostgreSQL)</name>
  <description>Flyway schema, JDBC repositories and the custom ADK Session/Memory/Artifact services. See ADR-0004.</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>commander-application</artifactId>
    </dependency>
    <!-- Implements ADK's BaseSessionService / BaseMemoryService / BaseArtifactService SPIs. -->
    <dependency>
      <groupId>com.google.adk</groupId>
      <artifactId>google-adk</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jdbc</artifactId>
    </dependency>
    <!--
      Spring Boot 4 moved Flyway auto-configuration out of spring-boot-autoconfigure into its own
      module. Depending on flyway-core alone (the Boot 3 habit) puts Flyway on the classpath but
      wires up nothing: migrations never run, and there is no warning - just a missing schema.
      The starter is what actually enables it.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <!-- The approval-resume test exercises the real ADK tool and the fake model together. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>commander-adk</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>commander-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
